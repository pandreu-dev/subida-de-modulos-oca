            </form>
        </field>
    </record>
    <record id="view_x_crm_practica_search" model="ir.ui.view">
        <field name="name">x_crm_practica.search</field>
        <field name="model">x_crm_practica</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <field name="x_studio_divisin"/>
                <filter name="inactive" string="Archivados" domain="[('x_active','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="groupby_division" string="Division"
                            context="{'group_by': 'x_studio_divisin'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_x_crm_practica" model="ir.actions.act_window">
