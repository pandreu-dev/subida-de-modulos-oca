                <field name="x_studio_divisin"/>
            </list>
        </field>
    </record>
    <record id="view_x_crm_practica_form" model="ir.ui.view">
        <field name="name">x_crm_practica.form</field>
        <field name="model">x_crm_practica</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
