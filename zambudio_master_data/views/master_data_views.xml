<odoo>

    <!-- =================================================================
         Vistas de codigo para los 5 maestros. Reemplazan a las vistas
         auto-generadas de Studio (que se pueden desactivar despues).
         ================================================================= -->

    <!-- ============ TIPO EMPLEADO ============ -->
    <record id="view_x_tipo_empleado_list" model="ir.ui.view">
        <field name="name">x_tipo_empleado.list</field>
        <field name="model">x_tipo_empleado</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Tipo empleado" editable="bottom">
                <field name="x_studio_sequence" widget="handle"/>
                <field name="x_name"/>
            </list>
        </field>
    </record>
    <record id="view_x_tipo_empleado_form" model="ir.ui.view">
        <field name="name">x_tipo_empleado.form</field>
        <field name="model">x_tipo_empleado</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Tipo empleado">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="x_active"/>
                    <group>
                        <field name="x_name"/>
                        <field name="x_studio_sequence"/>
                        <field name="x_active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_x_tipo_empleado_search" model="ir.ui.view">
        <field name="name">x_tipo_empleado.search</field>
        <field name="model">x_tipo_empleado</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name"/>
                <filter name="inactive" string="Archivados" domain="[('x_active','=',False)]"/>
            </search>
        </field>
    </record>
    <record id="action_x_tipo_empleado" model="ir.actions.act_window">
        <field name="name">Tipo empleado</field>
        <field name="res_model">x_tipo_empleado</field>
        <field name="view_mode">list,form</field>
    </record>

