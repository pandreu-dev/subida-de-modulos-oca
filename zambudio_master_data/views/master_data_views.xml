    <!-- ============ MENUS (Ajustes > Tecnico > Datos maestros configurables) ============ -->
    <menuitem id="menu_zambudio_master_root" name="Datos maestros configurables"
              parent="base.menu_custom" sequence="90"/>
    <menuitem id="menu_zambudio_master_employee" name="Empleado"
              parent="menu_zambudio_master_root" sequence="10"/>
