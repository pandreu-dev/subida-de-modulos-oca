<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Laura, 17/11/2026: en las facturas de proveedor con "Terminos de pago" Odoo
         oculta la fecha de vencimiento (account.view_move_form, div name="due_date").
         Se anade debajo, solo lectura, porque la calculan los terminos de pago. -->
    <record id="view_move_form_due_date_always" model="ir.ui.view">
        <field name="name">account.move.form.zambudio.due.date</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="invoice_date_due" readonly="1"
                       invisible="not invoice_payment_term_id or move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
