<odoo>
    <record id="res_config_settings_view_form_wip_accounting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wip.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="WIP" name="aunna_wip_accounting" groups="account.group_account_manager">
                    <block title="Contabilizacion WIP">
                        <setting
                            string="Diario WIP"
                            help="Diario contable usado para generar los asientos WIP."
                        >
                            <field name="aunnna_wip_journal_id"/>
                        </setting>
                        <setting
                            string="Cuenta ingreso WIP"
                            help="Cuenta de haber para el ingreso WIP. Ejemplo funcional: 705001."
                        >
                            <field name="aunnna_wip_income_account_id"/>
                        </setting>
                        <setting
                            string="Cuenta ingresos anticipados"
                            help="Cuenta de contrapartida. Ejemplo funcional: 485000."
                        >
                            <field name="aunnna_wip_deferred_account_id"/>
                        </setting>
                        <setting
                            string="Publicar automaticamente"
                            help="Si esta activo, el asiento WIP y su reversion se publican al crearse."
                        >
                            <field name="aunnna_wip_auto_post_moves"/>
                        </setting>
                        <setting
                            string="Habilitar contabilizacion automatica del WIP"
                            help="Activa el proceso diario que contabiliza el cierre mensual si no se ha generado manualmente durante el plazo de espera."
                        >
                            <field name="aunnna_wip_auto_accounting_enabled"/>
                        </setting>
                        <setting
                            string="Dias de espera para contabilizacion automatica"
                            help="Dia del mes siguiente en el que se genera el asiento automatico si nadie lo ha creado manualmente. Si el proceso falla, se reintentara los dias posteriores."
                            invisible="not aunnna_wip_auto_accounting_enabled"
                        >
                            <field name="aunnna_wip_auto_accounting_grace_days"/>
                        </setting>
                        <setting
                            string="Permitir WIP negativo"
                            help="Si no esta activo, un WIP negativo no generara asiento automatico."
                        >
                            <field name="aunnna_wip_allow_negative_amounts"/>
                        </setting>
                        <setting
                            string="Prueba controlada del automatico"
                            help="Simula la ejecucion mensual para una fecha elegida sin cambiar la fecha del servidor."
                        >
                            <button
                                name="action_open_aunnna_wip_auto_test_wizard"
                                string="Probar automatico WIP"
                                type="object"
                                class="btn-secondary"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_aunna_wip_accounting_settings" model="ir.actions.act_window">
        <field name="name">Configuracion WIP</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'aunna_wip_accounting'}</field>
    </record>

    <menuitem
        id="menu_aunna_wip_accounting_settings"
        name="Configuracion WIP"
        parent="account.menu_finance_entries"
        action="action_aunna_wip_accounting_settings"
        groups="account.group_account_manager"
        sequence="81"
    />
</odoo>
