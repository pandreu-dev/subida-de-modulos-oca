<odoo>
    <record id="view_aunna_wip_calculation_list_accounting" model="ir.ui.view">
        <field name="name">aunna.wip.calculation.list.accounting</field>
        <field name="model">aunna.wip.calculation</field>
        <field name="inherit_id" ref="aunna_wip_budget_calc.view_aunna_wip_calculation_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="accounting_state"/>
                <field name="move_id" optional="hide"/>
                <field name="reversal_move_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_aunna_wip_calculation_form_accounting" model="ir.ui.view">
        <field name="name">aunna.wip.calculation.form.accounting</field>
        <field name="model">aunna.wip.calculation</field>
        <field name="inherit_id" ref="aunna_wip_budget_calc.view_aunna_wip_calculation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="move_id" invisible="1"/>
                <field name="reversal_move_id" invisible="1"/>
                <button
                    name="action_create_wip_move"
                    string="Crear asiento WIP"
                    type="object"
                    class="btn-primary"
                    invisible="move_id or state == 'cancelled'"
                />
                <button
                    name="action_open_wip_move"
                    string="Abrir asiento"
                    type="object"
                    invisible="not move_id"
                />
                <button
                    name="action_open_reversal_move"
                    string="Abrir reversion"
                    type="object"
                    invisible="not reversal_move_id"
                />
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state == 'cancelled' or move_id</attribute>
            </xpath>
            <xpath expr="//group[@name='main_info']" position="after">
                <group string="Contabilizacion WIP" name="accounting_info">
                    <group>
                        <field name="accounting_state"/>
                        <field name="journal_id"/>
                        <field name="move_id"/>
                    </group>
                    <group>
                        <field name="reversal_move_id"/>
                        <field name="reversal_date"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
