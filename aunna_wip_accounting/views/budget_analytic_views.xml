<odoo>
    <record id="view_budget_analytic_form_wip_accounting" model="ir.ui.view">
        <field name="name">budget.analytic.form.wip.accounting</field>
        <field name="model">budget.analytic</field>
        <field name="inherit_id" ref="account_budget.view_budget_analytic_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='state']" position="before">
                <field name="wip_auto_accounting" invisible="1"/>
                <button
                    name="action_view_wip_account_moves"
                    string="Asientos WIP"
                    type="object"
                />
            </xpath>
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="wip_auto_accounting" readonly="state != 'draft'"/>
            </xpath>
            <!-- Columna "Reconocido acumulado" en las lineas del presupuesto, junto a Alcanzado. -->
            <xpath expr="//field[@name='budget_line_ids']//field[@name='achieved_amount']" position="after">
                <field name="aunnna_wip_recognized_amount" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
