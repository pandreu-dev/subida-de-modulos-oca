<odoo>
    <record id="view_aunna_wip_auto_test_wizard_form" model="ir.ui.view">
        <field name="name">aunna.wip.auto.test.wizard.form</field>
        <field name="model">aunna.wip.auto.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Probar contabilizacion automatica de avance">
                <group>
                    <field name="execution_date"/>
                    <field name="budget_id"/>
                    <field name="calculate_only"/>
                </group>
                <footer>
                    <button
                        name="action_run_test"
                        string="Ejecutar prueba"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
