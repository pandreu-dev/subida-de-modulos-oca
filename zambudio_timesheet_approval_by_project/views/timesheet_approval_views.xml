<odoo>
    <!-- Lista "A validar (mis proyectos)": los partes de horas sin validar de los
         proyectos que gestiona el usuario. Boton "Validar" en cabecera. -->
    <record id="view_project_timesheet_to_validate_list" model="ir.ui.view">
        <field name="name">account.analytic.line.project.to.validate.list</field>
        <field name="model">account.analytic.line</field>
        <field name="arch" type="xml">
            <list string="Partes a validar (mis proyectos)" create="0" edit="0" delete="0">
                <header>
                    <button name="action_zambudio_validate_project_timesheets"
                        type="object"
                        string="Validar"
                        class="btn-primary"
                        confirm="Vas a validar los partes de horas seleccionados de tus proyectos. Continuar?"/>
                </header>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="task_id" optional="show"/>
                <field name="name" optional="show"/>
                <field name="unit_amount" widget="float_time" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_project_timesheet_to_validate" model="ir.actions.act_window">
        <field name="name">A validar (mis proyectos)</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_project_timesheet_to_validate_list"/>
        <field name="domain">[('project_id.user_id', '=', uid), ('validated', '=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tienes partes de horas pendientes de validar en tus proyectos.
            </p>
            <p>
                Aqui apareceran los partes imputados a los proyectos de los que eres
                responsable. Selecciona los que quieras y pulsa "Validar".
            </p>
        </field>
    </record>

    <menuitem
        id="menu_project_timesheet_to_validate"
        name="A validar (mis proyectos)"
        parent="project.menu_main_pm"
        action="action_project_timesheet_to_validate"
        groups="hr_timesheet.group_hr_timesheet_user"
        sequence="90"/>
</odoo>
