<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sustituto en codigo de la personalizacion de Studio
         "upload url customization": anade Compania (company_id) tras la carpeta
         (folder_id) en el formulario de subir documento por URL. -->
    <record id="view_documents_upload_url_company" model="ir.ui.view">
        <field name="name">documents.upload.url.company</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_upload_url_view"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='folder_id']" position="after">
                <field name="company_id"/>
            </xpath>
        </field>
    </record>
</odoo>
