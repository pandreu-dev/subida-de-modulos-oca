<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_dynamic_standard_cost" model="ir.ui.view">
        <field name="name">product.category.form.dynamic.standard.cost</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="aunna_use_dynamic_standard_cost"/>
                <field name="aunna_dynamic_cost_counterpart_account_id"
                       invisible="not aunna_use_dynamic_standard_cost"/>
            </xpath>
        </field>
    </record>
</odoo>
