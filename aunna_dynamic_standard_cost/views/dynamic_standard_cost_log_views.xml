<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aunna_dynamic_standard_cost_log_list" model="ir.ui.view">
        <field name="name">aunna.dynamic.standard.cost.log.list</field>
        <field name="model">aunna.dynamic.standard.cost.log</field>
        <field name="arch" type="xml">
            <list string="Historico coste estandar dinamico" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="source"/>
                <field name="product_id"/>
                <field name="old_standard_price"/>
                <field name="new_standard_price"/>
                <field name="unit_difference"/>
                <field name="qty_available"/>
                <field name="valuation_difference"/>
                <field name="revaluation_move_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_aunna_dynamic_standard_cost_log_form" model="ir.ui.view">
        <field name="name">aunna.dynamic.standard.cost.log.form</field>
        <field name="model">aunna.dynamic.standard.cost.log</field>
        <field name="arch" type="xml">
            <form string="Historico coste estandar dinamico" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="source"/>
                            <field name="product_id"/>
                            <field name="categ_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="old_standard_price"/>
                            <field name="new_standard_price"/>
                            <field name="unit_difference"/>
                            <field name="qty_available"/>
                            <field name="valuation_difference"/>
                            <field name="revaluation_move_id"/>
                        </group>
                    </group>
                    <group string="Origen">
                        <field name="purchase_order_id"/>
                        <field name="purchase_line_id"/>
                        <field name="picking_id"/>
                        <field name="stock_move_id"/>
                        <field name="vendor_bill_id"/>
                        <field name="vendor_bill_line_id"/>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aunna_dynamic_standard_cost_log_search" model="ir.ui.view">
        <field name="name">aunna.dynamic.standard.cost.log.search</field>
        <field name="model">aunna.dynamic.standard.cost.log</field>
        <field name="arch" type="xml">
            <search string="Historico coste estandar dinamico">
                <field name="product_id"/>
                <field name="purchase_order_id"/>
                <field name="picking_id"/>
                <field name="vendor_bill_id"/>
                <filter name="receipt" string="Recepciones" domain="[('source', '=', 'receipt')]"/>
                <filter name="vendor_bill" string="Facturas proveedor" domain="[('source', '=', 'vendor_bill')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_source" string="Origen" context="{'group_by': 'source'}"/>
                    <filter name="group_company" string="Compania" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aunna_dynamic_standard_cost_log" model="ir.actions.act_window">
        <field name="name">Historico coste estandar dinamico</field>
        <field name="res_model">aunna.dynamic.standard.cost.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_aunna_dynamic_standard_cost_log_search"/>
    </record>

    <menuitem
        id="menu_aunna_dynamic_standard_cost_log"
        name="Historico coste estandar dinamico"
        parent="stock.menu_stock_config_settings"
        action="action_aunna_dynamic_standard_cost_log"
        sequence="95"/>
</odoo>
