<odoo>
    <record id="view_picking_form_inherit_aunna_product_category_column" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.aunna.product.category.column</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']//field[@name='product_id']" position="after">
                <field name="aunna_product_categ_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
