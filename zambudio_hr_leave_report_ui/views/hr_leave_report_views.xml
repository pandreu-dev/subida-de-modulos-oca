<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sustituto en codigo de la personalizacion de Studio
         "report.hr.holidays.report.leave_all.list customization": columna Tipo de
         ausencia (holiday_status_id) tras number_of_hours. Opcional visible por defecto. -->
    <record id="view_leave_report_list_status" model="ir.ui.view">
        <field name="name">hr.leave.report.list.holiday.status</field>
        <field name="model">hr.leave.report</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number_of_hours']" position="after">
                <field name="holiday_status_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
