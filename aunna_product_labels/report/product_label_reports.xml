<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_product_label_17x54" model="report.paperformat">
        <field name="name">Etiqueta producto 17 x 54 mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">54</field>
        <field name="page_height">17</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <record id="paperformat_product_label_29x90" model="report.paperformat">
        <field name="name">Etiqueta producto 29 x 90 mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">90</field>
        <field name="page_height">29</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <record id="paperformat_product_label_30x30" model="report.paperformat">
        <field name="name">Etiqueta producto 30 x 30 mm</field>
