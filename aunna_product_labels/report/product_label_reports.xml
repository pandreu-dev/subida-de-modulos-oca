    <record id="action_report_product_label_17x54" model="ir.actions.report">
        <field name="name">Etiqueta producto 17 x 54 mm</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aunna_product_labels.report_product_label_17x54</field>
        <field name="report_file">aunna_product_labels.report_product_label_17x54</field>
