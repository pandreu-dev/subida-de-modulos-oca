                    overflow: hidden;
                    font-size: 13pt;
                    font-weight: 700;
                    line-height: 4.1mm;
                }
                .aunna-label-29x90 .aunna-label-ref {
                    font-size: 8pt;
                    font-weight: 700;
                    line-height: 3.4mm;
                }
                .aunna-label-29x90 .aunna-label-barcode {
                    display: block;
                    width: 68mm;
                    height: 10.4mm;
                    margin: 0.4mm auto 0;
                }
                .aunna-label-29x90 .aunna-label-barcode-text {
                    font-size: 7.5pt;
                    font-weight: 700;
                    line-height: 2.6mm;
                }
                .aunna-label-29x90 .aunna-label-no-barcode {
                    margin-top: 3mm;
                    font-size: 10pt;
                    font-weight: 700;
                    border: 0.3mm solid #000;
                    padding: 2mm;
                }
            </style>
            <t t-foreach="labels" t-as="label">
                <div class="page">
                    <t t-set="label_class" t-value="'aunna-label-29x90'"/>
                    <t t-call="aunna_product_labels.label_content_common"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_product_label_30x30">
        <t t-call="web.html_container">
            <style>
                @page { size: 30mm 30mm; margin: 0; }
                html, body { margin: 0; padding: 0; }
                .page { page-break-after: always; }
                .aunna-label-30x30 {
