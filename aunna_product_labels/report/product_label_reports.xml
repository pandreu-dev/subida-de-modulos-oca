        <field name="format">custom</field>
        <field name="page_width">30</field>
        <field name="page_height">30</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <record id="action_report_product_label_17x54" model="ir.actions.report">
        <field name="name">Etiqueta producto 17 x 54 mm</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aunna_product_labels.report_product_label_17x54</field>
        <field name="report_file">aunna_product_labels.report_product_label_17x54</field>
        <field name="paperformat_id" ref="paperformat_product_label_17x54"/>
        <field name="print_report_name">'Etiquetas producto 17x54'</field>
    </record>

    <record id="action_report_product_label_29x90" model="ir.actions.report">
        <field name="name">Etiqueta producto 29 x 90 mm</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aunna_product_labels.report_product_label_29x90</field>
        <field name="report_file">aunna_product_labels.report_product_label_29x90</field>
        <field name="paperformat_id" ref="paperformat_product_label_29x90"/>
        <field name="print_report_name">'Etiquetas producto 29x90'</field>
    </record>

    <record id="action_report_product_label_30x30" model="ir.actions.report">
        <field name="name">Etiqueta producto 30 x 30 mm</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aunna_product_labels.report_product_label_30x30</field>
        <field name="report_file">aunna_product_labels.report_product_label_30x30</field>
        <field name="paperformat_id" ref="paperformat_product_label_30x30"/>
        <field name="print_report_name">'Etiquetas producto 30x30'</field>
    </record>

    <template id="label_content_common">
        <div t-att-class="label_class">
            <div class="aunna-label-name" t-esc="label['name']"/>
            <div class="aunna-label-ref">
                <span>REF: </span>
                <span t-esc="label['reference'] or '-'"/>
            </div>
            <t t-if="label['barcode']">
                <img class="aunna-label-barcode"
                     t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=900&amp;height=220&amp;humanreadable=0' % label['barcode']"
                     alt="Barcode"/>
                <div class="aunna-label-barcode-text" t-esc="label['barcode']"/>
            </t>
            <t t-else="">
                <div class="aunna-label-no-barcode">SIN CODIGO DE BARRAS</div>
            </t>
        </div>
    </template>

    <template id="report_product_label_17x54">
        <t t-call="web.html_container">
            <style>
                @page { size: 54mm 17mm; margin: 0; }
                html, body { margin: 0; padding: 0; }
                .page { page-break-after: always; }
                .aunna-label-17x54 {
                    width: 54mm;
                    height: 17mm;
                    box-sizing: border-box;
                    padding: 0.9mm 1.3mm;
                    overflow: hidden;
                    font-family: Arial, Helvetica, sans-serif;
                    text-align: center;
                    color: #000;
                }
                .aunna-label-17x54 .aunna-label-name {
                    max-height: 5.2mm;
                    overflow: hidden;
                    font-size: 8pt;
                    font-weight: 700;
                    line-height: 2.6mm;
                }
                .aunna-label-17x54 .aunna-label-ref {
                    font-size: 5.7pt;
                    font-weight: 700;
                    line-height: 2.1mm;
                }
                .aunna-label-17x54 .aunna-label-barcode {
                    display: block;
                    width: 44mm;
                    height: 6.3mm;
                    margin: 0 auto;
                }
                .aunna-label-17x54 .aunna-label-barcode-text {
                    font-size: 5.5pt;
                    font-weight: 700;
                    line-height: 1.8mm;
                }
                .aunna-label-17x54 .aunna-label-no-barcode {
                    margin-top: 2mm;
                    font-size: 7pt;
                    font-weight: 700;
                    border: 0.25mm solid #000;
                    padding: 1mm;
                }
            </style>
            <t t-foreach="labels" t-as="label">
                <div class="page">
                    <t t-set="label_class" t-value="'aunna-label-17x54'"/>
                    <t t-call="aunna_product_labels.label_content_common"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_product_label_29x90">
        <t t-call="web.html_container">
            <style>
                @page { size: 90mm 29mm; margin: 0; }
                html, body { margin: 0; padding: 0; }
                .page { page-break-after: always; }
                .aunna-label-29x90 {
                    width: 90mm;
