            </style>
            <t t-foreach="labels" t-as="label">
                <div class="page">
                    <t t-set="label_class" t-value="'aunna-label-30x30'"/>
                    <t t-call="aunna_product_labels.label_content_common"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
