    <record id="action_report_product_label_30x30" model="ir.actions.report">
        <field name="name">Etiqueta producto 30 x 30 mm</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aunna_product_labels.report_product_label_30x30</field>
        <field name="report_file">aunna_product_labels.report_product_label_30x30</field>
        <field name="paperformat_id" ref="paperformat_product_label_30x30"/>
        <field name="print_report_name">'Etiquetas producto 30x30'</field>
    </record>

    <template id="label_content_common">
        <div t-att-class="label_class">
            <t t-if="label['barcode_src']">
                <div class="aunna-label-barcode-side">
                    <img class="aunna-label-barcode"
                         t-att-src="label['barcode_src']"
                         alt="Barcode"/>
                </div>
            </t>
            <t t-else="">
                <div class="aunna-label-barcode-side aunna-label-no-barcode-side">
                    <span>SIN CODIGO</span>
                </div>
            </t>
            <div class="aunna-label-info">
                <div class="aunna-label-name" t-esc="label['name']"/>
                <div class="aunna-label-ref">
                    <span>REF: </span>
                    <span t-esc="label['reference'] or '-'"/>
                </div>
                <div class="aunna-label-barcode-text" t-esc="label['barcode'] or 'SIN CODIGO DE BARRAS'"/>
            </div>
        </div>
    </template>

    <template id="report_product_label_17x54">
        <t t-call="web.html_container">
            <style>
                @page { size: 54mm 17mm; margin: 0; }
                html, body { margin: 0; padding: 0; }
                .page { page-break-after: always; }
                .aunna-label-17x54 {
                    position: relative;
                    width: 54mm;
                    height: 17mm;
                    box-sizing: border-box;
                    padding: 0.8mm 1.2mm 0.8mm 18.2mm;
                    overflow: hidden;
                    font-family: Arial, Helvetica, sans-serif;
                    color: #000;
                }
                .aunna-label-17x54 .aunna-label-barcode-side {
                    position: absolute;
                    left: 2.8mm;
                    top: 0.5mm;
                    width: 14.8mm;
                    height: 16mm;
                    overflow: hidden;
                }
                .aunna-label-17x54 .aunna-label-barcode {
                    position: absolute;
                    left: 50%;
                    top: 50%;
                    width: 16.2mm;
                    height: 14.2mm;
                    transform: translate(-50%, -50%) rotate(-90deg);
                    transform-origin: center center;
                }
                .aunna-label-17x54 .aunna-label-info {
                    width: 34.6mm;
                    height: 15.4mm;
                    overflow: hidden;
                    text-align: center;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: stretch;
                }
                .aunna-label-17x54 .aunna-label-name {
                    max-height: 8.4mm;
                    overflow: hidden;
                    font-size: 9.5pt;
                    font-weight: 700;
                    line-height: 4.2mm;
                }
                .aunna-label-17x54 .aunna-label-ref {
                    font-size: 6.4pt;
                    font-weight: 700;
                    line-height: 2.7mm;
                }
                .aunna-label-17x54 .aunna-label-barcode-text {
                    font-size: 7.4pt;
                    font-weight: 700;
                    line-height: 3.1mm;
                }
                .aunna-label-17x54 .aunna-label-no-barcode-side {
                    border: 0.25mm solid #000;
                    box-sizing: border-box;
                    font-size: 5pt;
                    font-weight: 700;
                    text-align: center;
                    line-height: 14.4mm;
                }
            </style>
            <t t-foreach="labels" t-as="label">
                <div class="page">
                    <t t-set="label_class" t-value="'aunna-label-17x54'"/>
                    <t t-call="aunna_product_labels.label_content_common"/>
                </div>
            </t>
        </t>
    </template>

