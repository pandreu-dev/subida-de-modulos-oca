<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- El TCV oficial vive en la ficha del proyecto (tcv_amount). Si cambia por
         cualquier vía (pedido de venta nuevo, edición…), el reparto del ingreso
         de ese proyecto se rehace. Como tcv_amount es un campo CALCULADO (no
         pasa por write), este cron horario es la vía normal de detección, junto
         con la apertura de la pestaña de seguimiento y los botones. -->
    <record id="cron_sincronizar_tcv" model="ir.cron">
        <field name="name">Producción: sincronizar TCV de la ficha con el reparto</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="state">code</field>
        <field name="code">model.cron_sincronizar_tcv()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
