<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_produccion_importar_form" model="ir.ui.view">
        <field name="name">produccion.importar.form</field>
        <field name="model">produccion.importar</field>
        <field name="arch" type="xml">
            <form string="Importar / Exportar producción">
                <div class="alert alert-info" role="alert">
                    Descarga la plantilla con los últimos datos cargados, edítala en Excel y
                    vuelve a subirla. Los meses ya cerrados no se modifican.
                </div>
                <group>
                    <field name="project_id" readonly="1"/>
                </group>
                <group string="1 · Descargar plantilla con los datos actuales">
                    <button name="action_exportar" type="object" string="Generar plantilla"
                            class="btn-primary"/>
                    <field name="plantilla" filename="nombre_plantilla"
                           invisible="not plantilla"/>
                    <field name="nombre_plantilla" invisible="1"/>
                </group>
                <group string="2 · Subir la plantilla rellenada">
                    <field name="fichero" filename="nombre_fichero"/>
                    <field name="nombre_fichero" invisible="1"/>
                </group>
                <footer>
                    <button name="action_importar" type="object" string="Importar"
                            class="btn-primary" invisible="not fichero"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_importar_produccion" model="ir.actions.act_window">
        <field name="name">Importar / Exportar producción</field>
        <field name="res_model">produccion.importar</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>
</odoo>
