        <field name="model">project.project</field>
        <field name="inherit_id" ref="zambudio_produccion_new_version.view_project_form_produccion"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='produccion_new_version']//button[@name='action_ver_produccion']" position="before">
