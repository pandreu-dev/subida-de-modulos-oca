<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sustituto en codigo de la personalizacion de Studio
         "account.analytic.line.list customization": columnas Tarea (task_id, tras name)
         y Ticket (helpdesk_ticket_id, tras account_id). Opcionales visibles por defecto. -->
    <record id="view_analytic_line_list_columns" model="ir.ui.view">
        <field name="name">account.analytic.line.list.columns</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="task_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="helpdesk_ticket_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
