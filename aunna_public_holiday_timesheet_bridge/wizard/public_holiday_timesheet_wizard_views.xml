<odoo>
    <record id="view_aunna_public_holiday_timesheet_wizard_form" model="ir.ui.view">
        <field name="name">aunna.public.holiday.timesheet.wizard.form</field>
        <field name="model">aunna.public.holiday.timesheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar partes de festivos">
                <header>
                    <button name="action_simulate" string="Simular" type="object" class="btn-secondary"/>
                    <button name="action_generate" string="Generar/actualizar" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="name" invisible="1"/>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="execution_mode" widget="radio"/>
                            <field name="force_update"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Resultado">
                            <field name="line_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="employee_id"/>
                                    <field name="date"/>
                                    <field name="holiday_name"/>
                                    <field name="hours"/>
                                    <field name="action"/>
                                    <field name="analytic_line_id"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_simulate" string="Simular" type="object" class="btn-secondary"/>
                    <button name="action_generate" string="Generar/actualizar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aunna_public_holiday_timesheet_wizard" model="ir.actions.act_window">
        <field name="name">Generar partes de festivos</field>
        <field name="res_model">aunna.public.holiday.timesheet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem
        id="menu_aunna_public_holiday_timesheet_settings"
        name="Ajustes"
        parent="hr_timesheet.hr_timesheet_menu_configuration"
        action="hr_timesheet.hr_timesheet_config_settings_action"
        sequence="10"
        groups="base.group_system"
    />

    <menuitem
        id="menu_aunna_public_holiday_timesheet_wizard"
        name="Generar partes de festivos"
        parent="hr_timesheet.hr_timesheet_menu_configuration"
        action="action_aunna_public_holiday_timesheet_wizard"
        sequence="20"
        groups="hr_timesheet.group_hr_timesheet_approver"
    />
</odoo>
