<odoo>
    <record id="view_aunna_wip_calculation_list" model="ir.ui.view">
        <field name="name">aunna.wip.calculation.list</field>
        <field name="model">aunna.wip.calculation</field>
        <field name="arch" type="xml">
            <list string="Calculos Avance" create="0">
                <field name="cutoff_date"/>
                <field name="budget_id"/>
                <field name="source"/>
                <field name="achieved_amount"/>
                <field name="wip_amount"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_aunna_wip_calculation_form" model="ir.ui.view">
        <field name="name">aunna.wip.calculation.form</field>
        <field name="model">aunna.wip.calculation</field>
        <field name="arch" type="xml">
            <form string="Calculo Avance" create="0">
                <header>
                    <button
                        name="action_open_budget"
                        string="Abrir presupuesto"
                        type="object"
                    />
                    <button
                        name="action_cancel"
                        string="Cancelar"
                        type="object"
                        invisible="state == 'cancelled'"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group name="main_info">
                        <group>
                            <field name="budget_id"/>
                            <field name="cutoff_date"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="calculated_theoretical_amount"/>
                            <field name="achieved_amount"/>
                            <field name="wip_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lineas">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="budget_line_name"/>
                                    <field name="analytic_account_id"/>
                                    <field name="project_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="budgeted_amount"/>
                                    <field name="calculated_theoretical_amount"/>
                                    <field name="achieved_amount"/>
                                    <field name="wip_amount"/>
                                    <field name="manually_adjusted"/>
                                    <field name="adjustment_note" optional="hide"/>
                                    <field name="calculation_note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aunna_wip_calculation" model="ir.actions.act_window">
        <field name="name">Calculos Avance</field>
        <field name="res_model">aunna.wip.calculation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_aunna_wip_root"
        name="Calculos Avance"
        parent="account.menu_finance_entries"
        action="action_aunna_wip_calculation"
        groups="account.group_account_user"
        sequence="80"
    />
    <record id="menu_aunna_wip_calculations" model="ir.ui.menu">
        <field name="name">Calculos Avance</field>
        <field name="parent_id" ref="menu_aunna_wip_root"/>
        <field name="active">False</field>
    </record>
</odoo>
