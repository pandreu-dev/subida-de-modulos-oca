<odoo>
    <record id="view_zambudio_project_delegation_list" model="ir.ui.view">
        <field name="name">zambudio.project.delegation.list</field>
        <field name="model">zambudio.project.delegation</field>
        <field name="arch" type="xml">
            <list string="Delegaciones">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zambudio_project_delegation_form" model="ir.ui.view">
        <field name="name">zambudio.project.delegation.form</field>
        <field name="model">zambudio.project.delegation</field>
        <field name="arch" type="xml">
            <form string="Delegacion">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zambudio_project_delegation_search" model="ir.ui.view">
        <field name="name">zambudio.project.delegation.search</field>
        <field name="model">zambudio.project.delegation</field>
        <field name="arch" type="xml">
            <search string="Delegaciones">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_zambudio_project_delegation" model="ir.actions.act_window">
        <field name="name">Delegaciones</field>
        <field name="res_model">zambudio.project.delegation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_zambudio_project_delegation"
        name="Delegaciones"
        parent="project.menu_project_config"
        action="action_zambudio_project_delegation"
        groups="project.group_project_manager"
        sequence="65"
    />
</odoo>
