<odoo>
    <record id="view_purchase_order_form_inherit_aunna_type" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.aunna.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="aunna_purchase_order_type_id" options="{'no_create_edit': True}" required="1"/>
            </xpath>
        </field>
    </record>

    <!-- Recoloca dos campos ESTANDAR del formulario, sin duplicarlos (position="move").
         Prioridad alta para aplicarse DESPUES de que existan las anclas: el Tipo pedido
         (record de arriba), picking_type_id (purchase_stock) y project_id (bridge de
         proyecto). No altera ninguna otra parte del formulario. -->
    <record id="view_purchase_order_form_inherit_aunna_type_layout" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.aunna.type.layout</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Proyecto justo despues de Tipo pedido -->
            <xpath expr="//field[@name='aunna_purchase_order_type_id']" position="after">
                <xpath expr="//field[@name='project_id']" position="move"/>
            </xpath>
            <!-- Condiciones de pago justo despues de Entregar a -->
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <xpath expr="//field[@name='payment_term_id']" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_inherit_aunna_create_bill_button" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.aunna.create.bill.button</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Boton "Crear factura" tras el statusbar (campo state). Sustituto en
                 codigo de la personalizacion de Studio (que llamaba a la accion 1295).
                 Llama al metodo NATIVO action_create_invoice (crea la factura de
                 proveedor y la abre); no depende de ningun id de accion de la BD. -->
            <xpath expr="//header/field[@name='state']" position="after">
                <button string="Crear factura"
                        type="object"
                        name="action_create_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_kpis_tree_inherit_aunna_type" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.inherit.aunna.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aunna_purchase_order_type_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_inherit_aunna_type" model="ir.ui.view">
        <field name="name">purchase.order.list.inherit.aunna.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aunna_purchase_order_type_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_inherit_aunna_type" model="ir.ui.view">
        <field name="name">purchase.order.search.inherit.aunna.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="aunna_purchase_order_type_id" string="Tipo pedido"/>
            </field>
            <xpath expr="//group/filter[@name='order_date']" position="after">
                <filter
                    string="Tipo pedido"
                    name="groupby_aunna_purchase_order_type"
                    domain="[]"
                    context="{'group_by': 'aunna_purchase_order_type_id'}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_view_search_inherit_aunna_type" model="ir.ui.view">
        <field name="name">purchase.order.select.inherit.aunna.type</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="aunna_purchase_order_type_id" string="Tipo pedido"/>
            </field>
            <xpath expr="//group/filter[@name='order_date']" position="after">
                <filter
                    string="Tipo pedido"
                    name="groupby_aunna_purchase_order_type"
                    domain="[]"
                    context="{'group_by': 'aunna_purchase_order_type_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
