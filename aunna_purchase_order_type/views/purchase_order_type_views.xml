<odoo>
    <record id="view_aunna_purchase_order_type_list" model="ir.ui.view">
        <field name="name">aunna.purchase.order.type.list</field>
        <field name="model">aunna.purchase.order.type</field>
        <field name="arch" type="xml">
            <list string="Tipos pedido">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_aunna_purchase_order_type_form" model="ir.ui.view">
        <field name="name">aunna.purchase.order.type.form</field>
        <field name="model">aunna.purchase.order.type</field>
        <field name="arch" type="xml">
            <form string="Tipo pedido">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aunna_purchase_order_type" model="ir.actions.act_window">
        <field name="name">Tipo pedido</field>
        <field name="res_model">aunna.purchase.order.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_aunna_purchase_order_type"
        name="Tipo pedido"
        parent="purchase.menu_purchase_config"
        action="action_aunna_purchase_order_type"
        sequence="15"
        groups="purchase.group_purchase_manager"
    />
</odoo>
