<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SIN privilege_id a propósito: en Odoo 19 los grupos de un mismo
         privilegio son una selección EXCLUYENTE en la ficha de usuario (elegir
         este quitaría «Administrador de proyecto»). Sin privilegio aparece
         como casilla en «Derechos extra». -->
    <record id="group_produccion_confirmar" model="res.groups">
        <field name="name">Producción: confirmar avance y recalcular</field>
        <field name="privilege_id" eval="False"/>
        <field name="comment">Puede confirmar el avance mensual (ingreso reconocido)
y lanzar el recálculo de datos reales.</field>
    </record>

    <!-- Los administradores de proyecto lo tienen implícito -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('aunna_produccion_real_borrar.group_produccion_confirmar'))]"/>
    </record>

    <record id="rule_avance_mes_company" model="ir.rule">
        <field name="name">Avance mensual: multicompañía</field>
        <field name="model_id" ref="model_produccion_avance_mes"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
