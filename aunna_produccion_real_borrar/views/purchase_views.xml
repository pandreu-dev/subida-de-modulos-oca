<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_tipo_coste" model="ir.ui.view">
        <field name="name">purchase.order.tipo.coste.produccion</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="tipo_coste_produccion"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_tipo_coste_list" model="ir.ui.view">
        <field name="name">purchase.order.tipo.coste.produccion.list</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="tipo_coste_produccion" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Facturas de proveedor: mismo campo, para las que NO vienen de un pedido
         de compra (p. ej. la factura de un subcontratista registrada a mano). -->
    <record id="view_move_form_tipo_coste" model="ir.ui.view">
        <field name="name">account.move.form.tipo.coste.produccion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']//field[@name='partner_bank_id']" position="after">
                <field name="tipo_coste_produccion"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
