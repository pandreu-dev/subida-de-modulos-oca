<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sustituto en codigo de la personalizacion de Studio
         "project.milestone.view.list customization": columna quantity_percentage
         (% cantidad) tras la fecha limite. Opcional visible por defecto. -->
    <record id="view_milestone_list_quantity" model="ir.ui.view">
        <field name="name">project.milestone.list.quantity.percentage</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deadline']" position="after">
                <field name="quantity_percentage" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
