<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_exportar_br_form" model="ir.ui.view">
        <field name="name">produccion.exportar.br.form</field>
        <field name="model">produccion.exportar.br</field>
        <field name="arch" type="xml">
            <form string="Exportar Seguimiento económico">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="anio"/>
                    <field name="incluir_agregados"/>
                </group>
                <group invisible="not fichero">
                    <field name="fichero" filename="nombre_fichero" readonly="1"
                           string="Descargar"/>
                    <field name="nombre_fichero" invisible="1"/>
                </group>
                <footer>
                    <button name="action_exportar" type="object"
                            string="Generar Excel" class="btn-primary"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_exportar_br" model="ir.actions.act_window">
        <field name="name">Exportar Seguimiento económico</field>
        <field name="res_model">produccion.exportar.br</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>
</odoo>
