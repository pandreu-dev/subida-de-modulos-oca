<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_aunna_departments" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.aunna.departments</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field
                    name="aunna_department_in_id"
                    invisible="picking_type_code not in ('incoming', 'internal')"
                    options="{'no_create_edit': True}"
                />
                <field
                    name="aunna_department_out_id"
                    invisible="picking_type_code not in ('outgoing', 'internal')"
                    options="{'no_create_edit': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_picking_list_inherit_aunna_departments" model="ir.ui.view">
        <field name="name">stock.picking.list.inherit.aunna.departments</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="aunna_department_out_id" string="Departamento salida" optional="show"/>
                <field name="aunna_department_in_id" string="Departamento entrada" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="aunna_goods_value" string="Valor" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_inherit_aunna_departments" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.aunna.departments</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="aunna_department_id" string="Departamento"/>
                <field name="aunna_department_out_id" string="Departamento salida"/>
                <field name="aunna_department_in_id" string="Departamento entrada"/>
                <filter
                    string="Departamento entrada"
                    name="groupby_aunna_department_in"
                    context="{'group_by': 'aunna_department_in_id'}"
                />
                <filter
                    string="Departamento salida"
                    name="groupby_aunna_department_out"
                    context="{'group_by': 'aunna_department_out_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
