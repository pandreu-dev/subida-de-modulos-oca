<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_aunna_department" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.aunna.department</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="aunna_department_in_id" options="{'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Sustituto en codigo de la personalizacion de Studio
         "purchase.order...list customization": columna Departamento (aunna_department_in_id)
         en el listado KPI de compras, tras el proveedor. -->
    <record id="view_purchase_order_kpis_tree_inherit_aunna_department" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.inherit.aunna.department</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="aunna_department_in_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
